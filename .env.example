# SpendOS local/service
SPENDOS_PROXY_PORT=4191
SPENDOS_STATE_FILE=data/spendos-state.json

# Base / Base Sepolia RPC
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployment
SPENDOS_DEPLOY_NETWORK=base-sepolia
PRIVATE_KEY=0x...
SPENDOS_DEPLOYER_PRIVATE_KEY=0x...

# Contract addresses
SPENDOS_VAULT_ADDRESS=0x...
USDC_ADDRESS=0x...

# Operator / owner setup
SPENDOS_OPERATOR_PRIVATE_KEY=0x...
SPENDOS_OPERATOR_ADDRESS=0x...
SPENDOS_OWNER_PRIVATE_KEY=0x...
SPENDOS_AGENT_VAULT=0x...

# Policy bootstrap
SPENDOS_AGENT=research-agent
SPENDOS_DAILY_LIMIT=10
SPENDOS_PER_TRANSACTION_LIMIT=0.25
SPENDOS_DOMAINS=api.tokensight.io,risk.baseintel.net,decode.calldata.run
SPENDOS_CONTRACTS=0x8335...2913,0x4200...0006,0x2f5a...bace
SPENDOS_POLICY_DIGEST=
